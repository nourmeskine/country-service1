apiVersion: apps/v1
kind: Deployment
metadata:
  name: country-service
  namespace: jenkins
spec:
  replicas: 2
  selector:
    matchLabels:
      app: country-service
  template:
    metadata:
      labels:
        app: country-service
    spec:
      containers:
        - name: country-service
          # REMPLACER par ton identifiant Docker Hub
          image: VOTRE_IDENTIFIANT_DOCKERHUB/my-country-service:v1
          imagePullPolicy: Always
          ports:
            - containerPort: 8080
